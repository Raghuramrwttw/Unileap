# Copy to .env and fill in.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://unileapoverseas.com

# PostgreSQL
DB_NAME=unileap
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
# DB_ENGINE=sqlite   # only for a quick throwaway run without Postgres

# Email new enquiries to these addresses (comma separated)
ENQUIRY_NOTIFY_EMAILS=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Password for accounts created by: manage.py setup_unileap --demo-users
DEMO_PASSWORD=Unileap@2026
